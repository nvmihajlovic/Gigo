---
import '../styles/global.css';
import MobileActionBar from '../components/MobileActionBar.astro';
import { absoluteSiteUrl, languageTags, openGraphLocales, siteLocales } from '../data/seo';
import { siteRoutes, type Locale, type SitePage } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  page: SitePage;
}

const { title, description, lang = 'sr', page } = Astro.props;
const site = Astro.site;

if (!site) {
  throw new Error('Set the site URL in astro.config.mjs to render SEO metadata.');
}

const canonicalUrl = absoluteSiteUrl(siteRoutes[lang][page], site);
const siteUrl = absoluteSiteUrl('/', site);
const siteName = {
  sr: 'Restoran Gigo',
  en: 'Restaurant Gigo',
  ru: 'Ресторан Gigo',
}[lang];
const socialImageUrl = new URL('/images/galerija%203.jpg', site).href;
const socialImageAlt = {
  sr: 'Domaća jela na trpezi restorana Gigo',
  en: 'Homestyle dishes at a table at Restaurant Gigo',
  ru: 'Домашние блюда на столе в ресторане Gigo',
}[lang];
const restaurantId = `${siteUrl}#restaurant`;
const websiteId = `${siteUrl}#website`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Restaurant',
      '@id': restaurantId,
      name: 'Restoran Gigo',
      url: siteUrl,
      image: [
        new URL('/images/galerija%203.jpg', site).href,
        new URL('/images/galerija%204.jpg', site).href,
        new URL('/images/galerija%206.jpg', site).href,
      ],
      telephone: '+381112612253',
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: '+381112612253',
          contactType: 'reservations',
          availableLanguage: ['Serbian', 'English', 'Russian'],
        },
        {
          '@type': 'ContactPoint',
          telephone: '+381611318967',
          contactType: 'reservations',
          availableLanguage: ['Serbian', 'English', 'Russian'],
        },
      ],
      email: 'info@restorangigo.rs',
      foundingDate: '1998',
      servesCuisine: ['Serbian', 'Balkan'],
      acceptsReservations: true,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Gornjogradska 76',
        addressLocality: 'Zemun',
        addressRegion: 'Belgrade',
        addressCountry: 'RS',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: [
            'https://schema.org/Monday',
            'https://schema.org/Tuesday',
            'https://schema.org/Wednesday',
            'https://schema.org/Thursday',
            'https://schema.org/Friday',
            'https://schema.org/Saturday',
          ],
          opens: '10:00',
          closes: '23:00',
        },
      ],
      menu: absoluteSiteUrl(siteRoutes[lang].menu, site),
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: siteName,
      inLanguage: siteLocales.map((locale) => languageTags[locale]),
      publisher: { '@id': restaurantId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: languageTags[lang],
      isPartOf: { '@id': websiteId },
      about: { '@id': restaurantId },
      primaryImageOfPage: socialImageUrl,
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f5f1e8" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {siteLocales.map((locale) => (
      <link rel="alternate" hreflang={languageTags[locale]} href={absoluteSiteUrl(siteRoutes[locale][page], site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteSiteUrl(siteRoutes.sr[page], site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={openGraphLocales[lang]} />
    {siteLocales.filter((locale) => locale !== lang).map((locale) => (
      <meta property="og:locale:alternate" content={openGraphLocales[locale]} />
    ))}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1500" />
    <meta property="og:image:height" content="1000" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=optional"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <slot />
    <MobileActionBar locale={lang} />
    <button class="back-to-top" type="button" aria-label={lang === 'sr' ? 'Na vrh stranice' : lang === 'en' ? 'Back to top' : 'Наверх страницы'} hidden>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 12V3m-4 4 4-4 4 4" />
      </svg>
      <span>{lang === 'sr' ? 'Na vrh' : lang === 'en' ? 'Back to top' : 'Наверх'}</span>
    </button>
    <script>
      const backToTop = document.querySelector<HTMLButtonElement>('.back-to-top');
      const footer = document.querySelector<HTMLElement>('.site-footer');
      const gathering = document.querySelector<HTMLElement>('.gathering');

      if (backToTop) {
        const updateVisibility = () => {
          const footerVisible = footer
            ? footer.getBoundingClientRect().top < window.innerHeight
            : false;
          backToTop.hidden = window.scrollY < 420 || footerVisible;

          const buttonRect = backToTop.getBoundingClientRect();
          const gatheringRect = gathering?.getBoundingClientRect();
          const overlapsGathering = gatheringRect
            ? gatheringRect.left < buttonRect.right &&
              gatheringRect.right > buttonRect.left &&
              gatheringRect.top < buttonRect.bottom &&
              gatheringRect.bottom > buttonRect.top
            : false;
          backToTop.classList.toggle(
            'back-to-top--on-wine',
            !backToTop.hidden && overlapsGathering,
          );
        };

        window.addEventListener('scroll', updateVisibility, { passive: true });
        window.addEventListener('resize', updateVisibility);
        updateVisibility();
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'auto' });
        });
      }
    </script>
    <script>
      const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      const mobileMenuPanel = mobileMenu?.querySelector<HTMLElement>('.mobile-menu-panel');
      const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>('summary');
      const mobileMenuHeader = mobileMenu?.closest<HTMLElement>('.site-header');

      if (mobileMenu && mobileMenuPanel && mobileMenuSummary && mobileMenuHeader) {
        const closeMobileMenu = (restoreFocus = true) => {
          mobileMenu.open = false;
          if (restoreFocus) mobileMenuSummary.focus();
        };

        mobileMenu.addEventListener('toggle', () => {
          document.documentElement.classList.toggle('mobile-menu-open', mobileMenu.open);
          mobileMenuHeader.classList.toggle('mobile-menu-open', mobileMenu.open);
          if (mobileMenu.open) {
            window.setTimeout(() => {
              if (mobileMenu.open) {
                mobileMenu.querySelector<HTMLButtonElement>('.mobile-menu-close')?.focus();
              }
            }, 0);
          }
        });

        mobileMenu.querySelectorAll<HTMLButtonElement>('[data-mobile-menu-close]').forEach((button) => {
          button.addEventListener('click', () => closeMobileMenu());
        });

        mobileMenu.querySelectorAll<HTMLAnchorElement>('.mobile-menu-panel a').forEach((link) => {
          link.addEventListener('click', () => closeMobileMenu(false));
        });

        document.addEventListener('keydown', (event) => {
          if (!mobileMenu.open) return;

          if (event.key === 'Escape') {
            event.preventDefault();
            closeMobileMenu();
            return;
          }

          if (event.key !== 'Tab') return;
          const focusable = Array.from(
            mobileMenuPanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
          );
          const first = focusable[0];
          const last = focusable[focusable.length - 1];

          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first?.focus();
          }
        });
      }
    </script>
    <script>
      const categoryMenus = document.querySelectorAll<HTMLElement>('[data-category-menu]');

      categoryMenus.forEach((menu) => {
        const categoryNav = menu.querySelector<HTMLElement>('.category-nav');
        const categories = Array.from(menu.querySelectorAll<HTMLElement>('.menu-category'));
        const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('.category-nav a'));
        let updateFrame = 0;
        let activeCategoryIndex = -1;

        if (!categoryNav || categories.length !== links.length) {
          throw new Error('Category navigation does not match its category sections.');
        }

        const updateActiveCategory = () => {
          updateFrame = 0;
          const activeLine = categoryNav.getBoundingClientRect().bottom + 32;
          let activeIndex = 0;

          categories.forEach((category, index) => {
            if (category.getBoundingClientRect().top <= activeLine) activeIndex = index;
          });
          if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
            activeIndex = categories.length - 1;
          }

          if (activeCategoryIndex !== activeIndex) {
            links.forEach((link, index) => {
              if (index === activeIndex) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });

            if (categoryNav.scrollWidth > categoryNav.clientWidth) {
              const activeLink = links[activeIndex];
              const navRect = categoryNav.getBoundingClientRect();
              const linkRect = activeLink.getBoundingClientRect();

              if (linkRect.left < navRect.left || linkRect.right > navRect.right) {
                const targetLeft =
                  categoryNav.scrollLeft +
                  linkRect.left -
                  navRect.left -
                  (navRect.width - linkRect.width) / 2;
                categoryNav.scrollTo({ left: targetLeft, behavior: 'smooth' });
              }
            }

            activeCategoryIndex = activeIndex;
          }
        };

        const scheduleActiveCategoryUpdate = () => {
          if (updateFrame) return;
          updateFrame = window.requestAnimationFrame(updateActiveCategory);
        };

        window.addEventListener('scroll', scheduleActiveCategoryUpdate, { passive: true });
        window.addEventListener('resize', scheduleActiveCategoryUpdate);
        updateActiveCategory();
      });
    </script>
  </body>
</html>
