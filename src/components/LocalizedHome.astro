  heroEyebrow: string;
  heroTitle: string;
  heroAccent: string;
  heroText: string;
  heroSlides: { src: string; alt: string }[];
  heroSliderLabel: string;
  heroSliderControls: string;
  heroSliderShow: string;
  heroSliderPause: string;
  heroSliderPlay: string;
  reserve: string;
  menuLink: string;
  introEyebrow: string;
  introTitle: string;
  introAccent: string;
  introText: string;
  introSecond: string;
  storyLink: string;
  menuEyebrow: string;
  menuTitle: string;
  menuAccent: string;
  menuLinkAll: string;
  cards: [string, string, string, string, SitePage][];
  valuesEyebrow: string;
  valuesTitle: string;
  values: [string, string][];
  gatheringEyebrow: string;
  gatheringTitle: string;
  gatheringAccent: string;
  gatheringText: string;
  visit: string;
  visitEyebrow: string;
  visitTitle: string;
  visitAccent: string;
  visitText: string;
  addressLabel: string;
  hoursLabel: string;
  days: string;
  hours: string;
  closed: string;
  phoneLabel: string;
  mapLink: string;
  location: string;
}>;

const text = copy[locale];
---

<section class="hero" aria-labelledby="localized-hero-title">
  <HeroSlider
    slides={text.heroSlides}
    label={text.heroSliderLabel}
    controlsLabel={text.heroSliderControls}
    showSlideLabel={text.heroSliderShow}
    pauseLabel={text.heroSliderPause}
    playLabel={text.heroSliderPlay}
  />
  <div class="hero-content">
    <p class="eyebrow eyebrow-light"><span></span>{text.heroEyebrow}</p>
    <h1 id="localized-hero-title">{text.heroTitle} <span class="accent">{text.heroAccent}</span></h1>
    <p class="hero-description">{text.heroText}</p>
    <div class="hero-actions">
      <a class="button button-dark" href={siteRoutes[locale].contact}>{text.reserve}</a>
      <a class="hero-menu-link" href={siteRoutes[locale].menu}>{text.menuLink}</a>
    </div>
  </div>
</section>

<section class="intro section-wrap">
  <div class="intro-image-wrap">
    <img src="/images/galerija%203.jpg" alt="The welcoming interior of Restaurant Gigo" loading="lazy" />
    <span class="image-note">{text.location}</span>
  </div>
  <div class="intro-copy">
    <p class="eyebrow"><span></span>{text.introEyebrow}</p>
    <h2>{text.introTitle} <span class="accent">{text.introAccent}</span></h2>
    <p>{text.introText}</p>
    <p>{text.introSecond}</p>
    <a class="text-link" href={siteRoutes[locale].about}>{text.storyLink}</a>
  </div>
</section>

<section class="experience-section section-wrap">
  <div class="section-heading">
    <div>
      <p class="eyebrow"><span></span>{text.menuEyebrow}</p>
      <h2>{text.menuTitle} <span class="accent">{text.menuAccent}</span></h2>
    </div>
    <a class="text-link section-heading-link" href={siteRoutes[locale].menu}>{text.menuLinkAll}</a>
  </div>
  <div class="experience-grid">
    {text.cards.map(([title, description, image, alt, page]) => (
      <a class="experience-card" href={siteRoutes[locale][page]}>
        <div class="experience-image">
          <img src={image} alt={alt} loading="lazy" />
        </div>
        <div class="experience-copy">
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<section class="about-reasons section-wrap">
  <div class="section-heading">
    <div>
      <p class="eyebrow"><span></span>{text.valuesEyebrow}</p>
      <h2>{text.valuesTitle}</h2>
    </div>
  </div>
  <div class="about-reason-grid">
    {text.values.map(([title, description], index) => (
      <article class="about-reason">
        <span class="about-reason-number">{String(index + 1).padStart(2, '0')}</span>
        <h3>{title}</h3>
        <p>{description}</p>
      </article>
    ))}
  </div>
</section>

<section class="gathering">
  <div class="gathering-image">
    <img src="/images/image-32.jpg" alt="A shared meal at Restaurant Gigo" loading="lazy" />
  </div>
  <div class="gathering-content">
    <p class="eyebrow eyebrow-light"><span></span>{text.gatheringEyebrow}</p>
    <h2>{text.gatheringTitle} <span class="accent">{text.gatheringAccent}</span></h2>
    <p>{text.gatheringText}</p>
    <a class="button button-outline-light" href={siteRoutes[locale].contact}>{text.visit}</a>
  </div>
</section>

<section class="visit-section section-wrap">
  <div class="visit-copy">
    <p class="eyebrow"><span></span>{text.visitEyebrow}</p>
    <h2>{text.visitTitle} <span class="accent">{text.visitAccent}</span></h2>
    <p>{text.visitText}</p>
    <a class="button button-dark" href={siteRoutes[locale].contact}>{text.reserve}</a>
    <GoogleReviewsWidget locale={locale} />
  </div>
  <div class="visit-details">
    <div class="visit-detail">
      <span class="detail-label">{text.addressLabel}</span>
      <address>{siteCopy[locale].address}</address>
      <a class="text-link" href="https://maps.google.com/?q=Gornjogradska+76,+Zemun" target="_blank" rel="noreferrer">{text.mapLink}</a>
    </div>
    <div class="visit-detail">
      <span class="detail-label">{text.hoursLabel}</span>
      <p>{text.days}<br />{text.hours}</p>
      <p class="muted">{text.closed}</p>
      <OpeningStatus locale={locale} />
    </div>
    <div class="visit-detail">
      <span class="detail-label">{text.phoneLabel}</span>
      <a href="tel:+381112612253">011 / 2612-253</a>
      <a href="tel:+381611318967">061 / 1318-967</a>
    </div>
  </div>
</section>
