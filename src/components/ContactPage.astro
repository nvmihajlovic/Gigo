    hours: 'Opening hours',
    hoursValue: 'Monday - Saturday, 10:00 - 23:00',
    closed: 'Closed on Sundays',
    phoneLabel: 'Telephone',
    emailLabel: 'Email',
    mapTitle: 'Find us',
    mapLink: 'Open map',
  },
  ru: {
    eyebrow: 'Ваш стол ждёт вас',
    title: 'Забронировать стол',
    description: 'Отправьте запрос на бронирование или позвоните нам. Мы находимся по адресу Gornjogradska 76 в Земуне и открыты с понедельника по субботу с 10:00 до 23:00.',
    heroAlt: 'Подготовленный стол в ресторане Gigo',
