  },
  en: {
    eyebrow: 'Your table is waiting',
    title: 'Book a table',
    description: 'Send a reservation enquiry or call us. Find us at Gornjogradska 76 in Zemun, open Monday to Saturday from 10:00 to 23:00.',
    heroAlt: 'A table ready for guests at Restaurant Gigo',
    formTitle: 'Reservation enquiry',
    formIntro: 'Share a few details and our team will get back to you about your request.',
    reservationNotice: 'Submitting an enquiry does not mean your reservation is automatically accepted. It is confirmed only when the restaurant emails you a confirmation.',
    name: 'Full name',
