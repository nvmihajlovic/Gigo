---
import PageHero from './PageHero.astro';
import { galleryCopy, galleryImageFiles } from '../data/gallery';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = galleryCopy[locale];
const photos = galleryImageFiles.map((file, index) => ({
  full: `/images/gallery/${file}`,
  preview: `/images/gallery/previews/${file.replace(/\.[^.]+$/, '.webp')}`,
  alt: `${copy.photoAlt} ${index + 1}`,
}));
const heroPhoto = photos[0];
const galleryPhotos = photos.slice(1);
---

<PageHero
  eyebrow={copy.eyebrow}
  title={copy.title}
  description={copy.description}
  image={heroPhoto.full}
  alt={heroPhoto.alt}
  showSupport={false}
  compact
/>

<section class="gallery-section section-wrap" id="gallery" aria-label={copy.galleryLabel}>
  <div class="gallery-grid">
    {galleryPhotos.map((photo) => (
      <button
        class="gallery-card"
        type="button"
        data-gallery-item
        data-full={photo.full}
        data-alt={photo.alt}
      >
        <img src={photo.preview} alt={photo.alt} loading="lazy" decoding="async" />
        <span class="gallery-card-open" aria-hidden="true">+</span>
      </button>
    ))}
  </div>
</section>

<dialog class="gallery-lightbox" data-gallery-lightbox aria-label={copy.lightboxLabel}>
  <div class="gallery-lightbox-inner">
    <button class="gallery-lightbox-close" type="button" data-lightbox-close aria-label={copy.close}>
      <span aria-hidden="true">×</span>
    </button>
    <button class="gallery-lightbox-nav" type="button" data-lightbox-previous aria-label={copy.previous}>
      <span aria-hidden="true">‹</span>
    </button>
    <figure>
      <img class="gallery-lightbox-image" data-lightbox-image alt="" />
      <figcaption class="gallery-lightbox-caption" data-lightbox-caption aria-live="polite"></figcaption>
    </figure>
    <button class="gallery-lightbox-nav" type="button" data-lightbox-next aria-label={copy.next}>
      <span aria-hidden="true">›</span>
    </button>
  </div>
</dialog>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-gallery-lightbox]');
  const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-item]'));

  if (!lightbox || cards.length === 0) {
    throw new Error('Gallery lightbox could not be initialized.');
  }

  const image = lightbox.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const caption = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]');
  const closeButton = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  const previousButton = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-previous]');
  const nextButton = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-next]');

  if (!image || !caption || !closeButton || !previousButton || !nextButton) {
    throw new Error('Gallery lightbox controls are incomplete.');
  }

  let activeIndex = 0;

  const showPhoto = (index: number) => {
    activeIndex = (index + cards.length) % cards.length;
    const activeCard = cards[activeIndex];
    const fullImage = activeCard.dataset.full;
    const altText = activeCard.dataset.alt;

    if (!fullImage || !altText) {
      throw new Error('Gallery photo is missing its full image or alt text.');
    }

    image.src = fullImage;
    image.alt = altText;
    caption.textContent = altText;
  };

  cards.forEach((card, index) => {
    card.addEventListener('click', () => {
      showPhoto(index);
      lightbox.showModal();
    });
  });

  closeButton.addEventListener('click', () => lightbox.close());
  previousButton.addEventListener('click', () => showPhoto(activeIndex - 1));
  nextButton.addEventListener('click', () => showPhoto(activeIndex + 1));

  let touchStart: { x: number; y: number } | null = null;

  lightbox.addEventListener('pointerdown', (event) => {
    if (event.pointerType !== 'touch') return;
    if (event.target instanceof Element && event.target.closest('button')) return;
    touchStart = { x: event.clientX, y: event.clientY };
  });

  lightbox.addEventListener('pointerup', (event) => {
    if (event.pointerType !== 'touch' || !touchStart) return;

    const deltaX = event.clientX - touchStart.x;
    const deltaY = event.clientY - touchStart.y;
    touchStart = null;

    if (Math.abs(deltaX) < 48 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
    showPhoto(activeIndex + (deltaX < 0 ? 1 : -1));
  });

  lightbox.addEventListener('pointercancel', () => {
    touchStart = null;
  });

  lightbox.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      showPhoto(activeIndex - 1);
    } else if (event.key === 'ArrowRight') {
      event.preventDefault();
      showPhoto(activeIndex + 1);
    } else if (event.key === 'Escape') {
      event.preventDefault();
      lightbox.close();
    }
  });

  lightbox.addEventListener('click', (event) => {
    if (event.target === lightbox) {
      lightbox.close();
    }
  });
</script>

<style>
  .gallery-section {
    margin: 1rem auto clamp(4rem, 8vw, 8rem);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.55rem, 1.2vw, 1rem);
  }

  .gallery-card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: var(--paper-deep);
    cursor: zoom-in;
  }

  .gallery-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 450ms ease;
  }

  .gallery-card::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(47 27 14 / 32%));
    content: '';
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .gallery-card-open {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    z-index: 1;
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    color: var(--wine);
    font-size: 1.5rem;
    line-height: 1;
    opacity: 0;
    transform: translateY(0.3rem);
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .gallery-card:hover img,
  .gallery-card:focus-visible img {
    transform: scale(1.045);
  }

  .gallery-card:hover::after,
  .gallery-card:focus-visible::after,
  .gallery-card:hover .gallery-card-open,
  .gallery-card:focus-visible .gallery-card-open {
    opacity: 1;
  }

  .gallery-card:hover .gallery-card-open,
  .gallery-card:focus-visible .gallery-card-open {
    transform: translateY(0);
  }

  .gallery-lightbox {
    width: min(94vw, 76rem);
    max-width: none;
    max-height: 94vh;
    max-height: 94dvh;
    overflow: visible;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }

  .gallery-lightbox::backdrop {
    background: rgb(25 20 17 / 94%);
    backdrop-filter: blur(5px);
  }

  .gallery-lightbox-inner {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
  }

  .gallery-lightbox figure {
    min-width: 0;
    margin: 0;
    touch-action: pan-y;
  }

  .gallery-lightbox-image {
    width: 100%;
    height: min(78vh, 52rem);
    height: min(78dvh, 52rem);
    object-fit: contain;
  }

  .gallery-lightbox-caption {
    padding-top: 0.75rem;
    color: rgb(255 255 255 / 78%);
    font-size: 0.9rem;
    text-align: center;
  }

  .gallery-lightbox-close,
  .gallery-lightbox-nav {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 32%);
    border-radius: 50%;
    background: rgb(255 255 255 / 8%);
    color: #fff;
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .gallery-lightbox-close:hover,
  .gallery-lightbox-nav:hover {
    border-color: rgb(255 255 255 / 75%);
    background: rgb(255 255 255 / 18%);
  }

  .gallery-lightbox-close {
    position: absolute;
    top: -3.75rem;
    right: 0;
    font-size: 1.8rem;
  }

  .gallery-lightbox-nav {
    font-size: 2rem;
    line-height: 1;
  }

  @media (max-width: 1000px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 650px) {
    .gallery-section {
      margin-top: 0.5rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .gallery-card-open {
      right: 0.55rem;
      bottom: 0.55rem;
      width: 2rem;
      height: 2rem;
      opacity: 1;
      transform: none;
    }

    .gallery-card::after {
      opacity: 1;
    }

    .gallery-lightbox {
      width: 100vw;
      max-width: 100vw;
      padding: 0 0.5rem;
    }

    .gallery-lightbox-inner {
      grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem;
      gap: 0.35rem;
    }

    .gallery-lightbox-nav {
      width: 2.5rem;
      height: 2.5rem;
    }

    .gallery-lightbox-image {
      height: 72vh;
      height: 72dvh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card img,
    .gallery-card::after,
    .gallery-card-open,
    .gallery-lightbox-close,
    .gallery-lightbox-nav {
      transition: none;
    }
  }
</style>
